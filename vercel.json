{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "notification_service": {
      "root": "notification_service",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/notify/:path*",
      "destination": {
        "service": "notification_service"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/patients/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/doctors/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/appointments/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
