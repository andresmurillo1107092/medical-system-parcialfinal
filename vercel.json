{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "notification_service": {
      "root": "notification_service",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/notify",
      "destination": {
        "service": "notification_service"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "backend"
      }
    }
  ]
}
